# ---------------------------------------------------------------
# MR.MANDU BARBERS — variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o arquivo .env.
# ---------------------------------------------------------------

# Conexão PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mrmandu?schema=public"

# Segredo do Auth.js (gere com: openssl rand -base64 32)
AUTH_SECRET="troque-por-um-segredo-forte"

# URL pública da aplicação (usada em links de e-mail, ex.: redefinição de senha)
APP_URL="http://localhost:3000"

# Necessário quando rodando atrás de proxy/host diferente de localhost
AUTH_TRUST_HOST=true

# Fuso horário da barbearia (IANA). Todos os horários são interpretados nele.
NEXT_PUBLIC_SHOP_TIMEZONE="America/Sao_Paulo"

# Senha usada pelo seed para os usuários de teste (apenas desenvolvimento!)
SEED_PASSWORD="Mandu@2026"
