    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^0.544.0",
    "next": "^15.5.27",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.1.9",
    "react-dom": "^19.1.9",
    "react-hook-form": "^7.89.0",
